# ==============================================================================
# Plantilla de Variables de Entorno (Copia este archivo a .env)
# ==============================================================================

# API Key de Google Gemini (Obtén la tuya en: https://aistudio.google.com/app/api-keys)
GEMINI_API_KEY="tu_api_key_de_gemini_aqui"

# ==============================================================================
# Configuración Opcional de Transcripción Local (Faster-Whisper)
# ==============================================================================
WHISPER_MODEL="small"
WHISPER_COMPUTE_TYPE="int8"
WHISPER_LANGUAGE="es"

